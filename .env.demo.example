# Local screenshot/demo fixture only. Copy to .env.demo; never use a
# development or production database. The database name must end in _demo or
# _test. Integration tests clear this data, so do not run them while using the
# demo account.
DEMO_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/kitchen_keeps_test
DEMO_USER_PASSWORD=replace-with-a-demo-only-password
