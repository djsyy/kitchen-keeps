# Server runtime configuration. Copy to .env for local development.
# Production values belong in your deployment provider's secret configuration.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/kitchen_keeps
SESSION_SECRET=replace-with-a-random-32-character-or-longer-secret
NODE_ENV=development
PORT=8080
SERVER_URL=http://localhost:8080
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Production only: number of trusted reverse-proxy hops. Use 1 for one managed proxy.
TRUST_PROXY=0

# Email delivery
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Kitchen Keeps <noreply@example.com>

# Cloudinary server credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Client variables intentionally live in client/.env.development for local work
# and in the deployment provider's build environment for production builds.
