# Local integration and browser-test database. Never point this at development
# or production data; the test suite truncates it between tests.
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/kitchen_keeps_test
SESSION_SECRET=replace-with-a-test-only-secret
NODE_ENV=test
PORT=8081
SERVER_URL=http://127.0.0.1:8081
CLIENT_URL=http://127.0.0.1:4173
CORS_ORIGIN=http://127.0.0.1:4173
TRUST_PROXY=0
