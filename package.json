{
  "name": "whats-cooking-app",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "db:migration:create": "npm run db:migration:create --workspace server",
    "db:baseline": "npm run db:baseline --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:rollback": "npm run db:rollback --workspace server",
    "db:seed:ingredients": "npm run db:seed:ingredients --workspace server",
    "build:client": "npm run build --workspace client",
    "start:server": "npm run start --workspace server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "overrides": {
    "lodash": "4.17.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
