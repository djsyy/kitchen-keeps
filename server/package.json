{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "db:migration:create": "node-pg-migrate create --migrations-dir db/migrations --migration-file-language sql",
    "db:baseline": "node-pg-migrate up --migrations-dir db/migrations --envPath ../.env.migrations --database-url-var MIGRATION_DATABASE_URL --fake",
    "db:migrate": "node-pg-migrate up --migrations-dir db/migrations --envPath ../.env.migrations --database-url-var MIGRATION_DATABASE_URL",
    "db:migrate:production": "node-pg-migrate up --migrations-dir db/migrations --database-url-var DATABASE_URL",
    "db:rollback": "node-pg-migrate down --migrations-dir db/migrations --envPath ../.env.migrations --database-url-var MIGRATION_DATABASE_URL",
    "db:seed:ingredients": "node scripts/seedGlobalIngredients.js",
    "db:test:migrate": "NODE_ENV=test node-pg-migrate up --migrations-dir db/migrations --envPath ../.env.test --database-url-var TEST_DATABASE_URL",
    "db:test:seed": "NODE_ENV=test node scripts/seedGlobalIngredients.js",
    "db:test:verify": "npm run db:test:migrate && npm run db:test:seed && npm run db:test:seed",
    "ingredients:review": "node scripts/generateFoundationIngredientReview.js",
    "test": "vitest run --config vitest.unit.config.js",
    "test:integration": "npm run db:test:migrate && NODE_ENV=test vitest run --config vitest.integration.config.js",
    "start": "node index.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "multer": "^2.2.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "resend": "^6.12.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
