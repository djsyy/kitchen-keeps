{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "db:migration:create": "node-pg-migrate create --migrations-dir db/migrations --migration-file-language sql",
    "db:baseline": "node-pg-migrate up --migrations-dir db/migrations --envPath ../.env --fake",
    "db:migrate": "node-pg-migrate up --migrations-dir db/migrations --envPath ../.env",
    "db:rollback": "node-pg-migrate down --migrations-dir db/migrations --envPath ../.env",
    "db:seed:ingredients": "node scripts/seedGlobalIngredients.js",
    "ingredients:review": "node scripts/generateFoundationIngredientReview.js",
    "start": "node index.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.1",
    "http-status-codes": "^2.3.0",
    "pg": "^8.20.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.4"
  }
}
